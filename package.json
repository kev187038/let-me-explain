{
  "name": "let-me-explain",
  "version": "0.1.0",
  "description": "Wizard that teaches your AI coding assistant to teach you — installs learning instructions into Claude Code, Codex CLI, and Gemini CLI.",
  "type": "module",
  "bin": {
    "let-me-explain": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "ai",
    "claude-code",
    "codex",
    "gemini-cli",
    "agents-md",
    "learning",
    "junior-developer"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
