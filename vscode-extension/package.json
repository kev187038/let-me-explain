{
  "name": "let-me-explain",
  "displayName": "let-me-explain",
  "description": "Status-bar buttons for let-me-explain: allow a change, take it over and write it yourself, or hand your work back to Claude.",
  "version": "0.2.1",
  "publisher": "gabi",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "letMeExplain.done",
        "title": "I'm done typing",
        "category": "let-me-explain"
      },
      {
        "command": "letMeExplain.allow",
        "title": "Allow this change",
        "category": "let-me-explain"
      },
      {
        "command": "letMeExplain.letMeTry",
        "title": "Let me try \u2014 write it myself",
        "category": "let-me-explain"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.85.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kev187038/let-me-explain.git"
  },
  "homepage": "https://github.com/kev187038/let-me-explain"
}
